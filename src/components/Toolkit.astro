---
import { Image } from "astro:assets";
import { marquee } from "../data/content";
import Rail from "./Rail.astro";
import strata from "../assets/photos/svc-2.jpg";

// Six rows, each carrying the whole stack but started at a different tool, so
// no two rows ever line up and nothing repeats inside one screen. motion.ts
// clones each row past the panel width, mirrors it once, then runs it as a
// seamless loop whose speed and direction answer your scroll. The names are
// plain type on ruled paper: three sizes, ink for the small ones and pen for
// the heavy ones. One row sits on a powder highlighter swipe. The rows own
// the whole lower sheet and the heading stands on the first rule.
const starts = [0, 7, 13, 3, 17, 10];
const hi = 2;
// size tier (1 small, 2 mid, 3 large) per tool, indexed against marquee
const tier = [2, 1, 3, 1, 2, 3, 1, 2, 1, 1, 3, 2, 1, 2, 1, 3, 1, 1, 2, 1, 3, 2];

const rowTools = (start: number) =>
  marquee.map((_, k) => {
    const i = (start + k) % marquee.length;
    return { name: marquee[i], cls: `tool tool--t${tier[i]}` };
  });
---

<section class="slide tk" id="toolkit" aria-label="Tools I run daily">
  <Rail no="07" name="Toolkit" />

  <div class="tk__wall rv">
    <div class="tk__top">
      <Image class="cut cut--bot bleed tk__bot" data-drift="5" src={strata} alt="" widths={[300, 600]} sizes="28vw" />
      <div class="tk__head">
        <h2 class="d1 tk__a">Tools</h2>
        <span class="script tk__b" data-drift="6">I run daily</span>
      </div>
    </div>

    <ul class="tk__rows">
      {starts.map((s, n) => (
        <li class={`tk__row${n === hi ? " tk__row--hi" : ""}`} data-draw>
          <div class="tk__track">
            {rowTools(s).map((c) => <span class={c.cls}>{c.name}</span>)}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .tk {
    --sp: clamp(1.4rem, 3vw, 2.8rem);
    justify-content: flex-start;
  }
  @media (min-width: 900px) and (max-height: 850px) {
    .tk { --sp: clamp(1.1rem, 2.1vw, 1.9rem); }
  }

  /* The wrapper owns the whole content box of the sheet and runs a little
     past the rail's margins. The heading band sits directly on the first
     rule and the rows share out everything below it. */
  .tk__wall {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    min-height: calc(var(--board, 0px) - var(--sp) * 2);
    padding: clamp(1rem, 1.8vw, 1.4rem) calc(var(--gut) * 0.4) 0;
  }

  /* ── heading band: the word stands on the first rule, a leaf beside it ── */
  .tk__top { position: relative; flex: none; display: flex; align-items: flex-end; min-height: clamp(5rem, min(12.4vw, 19vh), 11rem); }
  .tk__head { position: relative; z-index: 3; display: flex; align-items: flex-end; gap: clamp(0.8rem, 2vw, 1.8rem); width: fit-content; margin: 0; }
  .tk__a { font-size: clamp(3rem, min(10.4vw, 16.4vh), 9.6rem); line-height: 0.8; margin-bottom: 0.03em; }
  .tk__b {
    display: block;
    flex: none;
    margin-bottom: 0.5rem;
    white-space: nowrap;
    font-size: clamp(1.6rem, min(3.8vw, 6.08vh), 3.4rem);
    rotate: -4deg;
  }

  .tk__bot {
    top: 0;
    right: -3%;
    width: clamp(220px, 27%, 380px);
    height: clamp(110px, 11vw, 168px);
    object-fit: cover;
    opacity: 0.75;
    rotate: 156deg;
    mask-image: radial-gradient(ellipse at 50% 50%, #000 42%, transparent 74%);
  }

  /* ── ruled rows: they fill whatever the heading leaves ── */
  .tk__rows {
    position: relative;
    z-index: 2;
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid var(--rule);
  }

  /* the rows run edge to edge; the panel's own overflow does the clipping */
  .tk__row {
    position: relative;
    flex: 1 1 0;
    display: flex;
    align-items: center;
    width: calc(100% + var(--gut) * 2);
    margin-inline: calc(var(--gut) * -1);
    border-top: 1px solid var(--rule);
    outline-offset: -4px;
  }
  /* the pen rule over each hairline, drawn across as the board is read */
  .tk__row::after {
    content: "";
    position: absolute;
    left: 0; right: 0; top: -1px;
    height: 2px;
    background: var(--pen);
    transform: scaleX(var(--draw, 1));
    transform-origin: 0 50%;
  }
  /* the highlighter swipe sits behind one row, a little crooked at both ends */
  .tk__row--hi::before {
    content: "";
    position: absolute;
    inset: 9% 0;
    z-index: 0;
    background: var(--powder);
    opacity: 0.62;
    clip-path: polygon(0 12%, 100% 0, 100% 88%, 0 100%);
  }
  .tk__track {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: baseline;
    gap: clamp(1.4rem, 3vw, 2.6rem);
    width: max-content;
    padding: 0.5rem var(--gut);
    will-change: transform;
    transition: opacity 0.4s var(--ease);
  }

  .tool { flex: none; cursor: default; color: var(--ink); white-space: nowrap; }
  /* a hairline tick between names, so the row reads as a typeset line */
  .tool::after {
    content: "";
    display: inline-block;
    width: 1px;
    height: 0.8em;
    margin-left: clamp(1.4rem, 3vw, 2.6rem);
    background: var(--ink);
    opacity: 0.28;
  }
  .tool--t1 { font-family: var(--display); font-size: clamp(1rem, min(1.5vw, 2.40vh), 1.35rem); font-weight: 500; letter-spacing: -0.005em; }
  .tool--t2 { font-family: var(--serif); font-size: clamp(1.3rem, min(2.7vw, 4.32vh), 2.5rem); font-weight: 400; font-style: italic; letter-spacing: -0.01em; }
  .tool--t3 { font-family: var(--serif); font-size: clamp(1.9rem, min(4.1vw, 6.56vh), 3.9rem); font-weight: 900; line-height: 1; letter-spacing: -0.015em; color: var(--pen); }

  /* ── the row you point at (or tab to) holds still and the others step back;
        the highlighted row never dims, it is the one accent ── */
  .tk__rows:has(.tk__row:hover) .tk__row:not(:hover):not(.tk__row--hi) .tk__track,
  .tk__rows:has(.tk__row:focus-visible) .tk__row:not(:focus-visible):not(.tk__row--hi) .tk__track { opacity: 0.45; }

  @media (max-width: 860px) {
    .tk__wall { min-height: 0; margin-inline: 0; padding-inline: 0; }
    .tk__top { min-height: 0; padding-bottom: 0.4rem; }
    .tk__a { font-size: clamp(3rem, min(16vw, 25.60vh), 5rem); }
    .tk__b { position: static; display: block; font-size: 1.6rem; }
    .tk__head { display: flex; align-items: baseline; gap: 0.8rem; flex-wrap: wrap; }
    .tk__bot { display: none; }
    .tk__row { flex: none; }
    .tool--t3 { font-size: 1.8rem; }
    .tool--t2 { font-size: 1.3rem; }
  }
</style>
