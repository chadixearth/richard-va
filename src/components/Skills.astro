---
import { Image } from "astro:assets";
import { services } from "../data/content";
import Rail from "./Rail.astro";
import Scribble from "./Scribble.astro";
import leaf from "../assets/photos/svc-3.jpg";
import strata from "../assets/photos/svc-2.jpg";

/* Composition note: the three groups are set like a contents page, not a card
   row, and they own the whole height of the sheet. A huge pen numeral hangs
   in the left margin, the serif title and blurb sit beside it, and the detail
   runs in two columns on the right. The heading band above them carries a
   tea-leaf clipping, a band of strata and one block of handwriting.
   Pointing at (or tabbing into) a service brings it forward and lets the
   other two recede; its pen rule is drawn by scroll (data-draw) and a
   highlighter band sweeps under it on hover. */
---

<section class="slide skills" id="skills">
  <Rail no="03" name="Skills" />

  <div class="skills__in rv">
    <div class="skills__band">
      <h2 class="skills__h">
        <span class="d1 skills__word">Skills &amp;</span>
        <span class="script skills__script">Expertise</span>
      </h2>
      <Image class="cut cut--bot bleed skills__bot1" data-drift="5" src={leaf} alt="" widths={[300, 600]} sizes="22vw" />
      <Image class="cut cut--bot bleed skills__bot2" data-drift="4" src={strata} alt="" widths={[300, 600]} sizes="22vw" />
      <div class="skills__note"><Scribble lines={5} seed={11} /></div>
    </div>

    <div class="skills__list">
      {
        services.map((s, i) => (
          <article class={`skills__blk skills__blk--${i + 1}`} data-draw>
            <span class="skills__no" data-drift="6">{s.no}</span>
            <div class="skills__main">
              <h3 class="d3 skills__t">{s.title}</h3>
              <p class="body-s skills__blurb">{s.blurb}</p>
            </div>
            <ul class="skills__items">
              {s.items.map((it) => <li>{it}</li>)}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .skills {
    --sp: clamp(1.4rem, 3vw, 2.8rem);
    justify-content: flex-start;
  }
  @media (min-width: 900px) and (max-height: 850px) {
    .skills { --sp: clamp(1.1rem, 2.1vw, 1.9rem); }
    .skills__blk { padding: 0.6rem 0 0.4rem; }
    .skills__items li { padding: 0.16rem 0 0.2rem; }
  }

  /* The wrapper is as tall as the board's content box and a little wider than
     the rail, so the sheet is used edge to edge. The padding puts the content
     back on the rail's margins; only the clippings run past them. */
  .skills__in {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    gap: clamp(0.5rem, 1.2vw, 1rem);
    min-height: calc(var(--board, 0px) - var(--sp) * 2);
    padding: clamp(1rem, 1.8vw, 1.4rem) calc(var(--gut) * 0.4) 0;
  }

  /* ── heading band: heavy serif, script signed under its tail ── */
  .skills__band { position: relative; min-height: clamp(5rem, min(11.6vw, 17.6vh), 10.4rem); }
  .skills__h { position: relative; z-index: 3; display: grid; justify-items: start; width: fit-content; margin: 0; }
  .skills__word { font-size: clamp(2.4rem, min(8.4vw, 13.4vh), 8rem); line-height: 0.84; white-space: nowrap; }
  .skills__script {
    display: block;
    justify-self: end;
    margin-top: -0.1em;
    margin-right: 0.2em;
    font-size: clamp(1.4rem, min(3.4vw, 5.44vh), 3rem);
    rotate: -2deg;
  }

  /* ── clippings and margin notes: all of them live in the heading band ── */
  .skills__bot1, .skills__bot2 {
    mask-image: radial-gradient(ellipse at 50% 50%, #000 42%, transparent 74%);
    object-fit: cover;
    opacity: 0.75;
  }
  .skills__bot1 { top: -2%; right: -3%; width: clamp(170px, 19%, 270px); height: clamp(100px, min(11vw, 17vh), 170px); rotate: 192deg; }
  .skills__bot2 { top: 6%; right: 20%; width: clamp(170px, 17%, 250px); height: clamp(90px, min(9.4vw, 14.5vh), 140px); rotate: -6deg; }
  .skills__note { position: absolute; z-index: 2; right: 40%; top: 18%; width: clamp(96px, 9%, 128px); rotate: -3deg; }

  /* ── the contents list: three equal rows that own the rest of the sheet ── */
  .skills__list {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-rows: repeat(3, minmax(0, 1fr));
    min-height: 0;
  }
  .skills__blk {
    position: relative;
    display: grid;
    grid-template-columns: clamp(5.2rem, min(14.6vw, 23vh), 13.8rem) minmax(0, 0.82fr) minmax(0, 1.7fr);
    column-gap: clamp(1.1rem, 2.4vw, 2.2rem);
    align-items: center;
    padding: 0.9rem 0 0.7rem;
    outline-offset: -4px;
    transition: opacity 0.4s var(--ease), translate 0.5s var(--ease);
  }
  /* the pen rule: drawn across as the board is read */
  .skills__blk::after {
    content: "";
    position: absolute;
    left: 0; right: 0; top: 0;
    height: 2px;
    background: var(--pen);
    transform: scaleX(var(--draw, 1));
    transform-origin: 0 50%;
  }
  /* the highlighter band that sweeps in under it when the row is chosen */
  .skills__blk::before {
    content: "";
    position: absolute;
    left: 0; right: 0; top: 2px;
    height: 7px;
    background: var(--powder);
    opacity: 0.8;
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.6s var(--ease);
  }

  .skills__no {
    display: block;
    font-family: var(--serif);
    font-weight: 900;
    font-size: clamp(3.4rem, min(11.4vw, 18vh), 10.8rem);
    line-height: 0.78;
    letter-spacing: -0.03em;
    color: var(--pen);
    white-space: nowrap;
    transform-origin: 0 60%;
    transition: scale 0.5s var(--ease);
  }
  .skills__t {
    font-family: var(--serif);
    font-weight: 700;
    font-size: clamp(1.05rem, min(2.3vw, 3.68vh), 2.1rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .skills__blurb { margin-top: 0.55rem; font-size: clamp(0.74rem, min(1.02vw, 1.63vh), 0.98rem); line-height: 1.5; color: var(--body); }

  .skills__items {
    columns: 2;
    column-gap: clamp(1rem, 2vw, 1.8rem);
    font-size: clamp(0.7rem, min(0.92vw, 1.47vh), 0.9rem);
    line-height: 1.38;
    color: var(--body);
  }
  .skills__items li {
    break-inside: avoid;
    padding: 0.26rem 0 0.3rem;
    border-bottom: 1px solid var(--rule);
    transition: border-color 0.4s var(--ease);
  }
  .skills__items li:first-child { padding-top: 0; }

  /* ── signature: the chosen service comes forward, the others recede ── */
  .skills__blk:hover,
  .skills__blk:focus-visible { translate: 0.7rem 0; }
  .skills__blk:hover::before,
  .skills__blk:focus-visible::before { transform: scaleX(1); }
  .skills__blk:hover .skills__no,
  .skills__blk:focus-visible .skills__no { scale: 1.07; }
  .skills__blk:hover .skills__items li,
  .skills__blk:focus-visible .skills__items li { border-bottom-color: var(--pen); }
  .skills__list:has(.skills__blk:hover) .skills__blk:not(:hover),
  .skills__list:has(.skills__blk:focus-visible) .skills__blk:not(:focus-visible) { opacity: 0.4; }

  @media (max-width: 1100px) {
    .skills__in { min-height: 0; grid-template-rows: auto; }
    .skills__list { grid-template-rows: none; gap: 1.2rem; }
    .skills__blk { grid-template-columns: auto minmax(0, 1fr); row-gap: 0.7rem; align-items: start; }
    .skills__no { font-size: clamp(3.4rem, min(9vw, 14.40vh), 5.6rem); }
    .skills__items { grid-column: 1 / -1; }
    .skills__bot1 { opacity: 0.6; }
    .skills__note { display: none; }
  }
  @media (max-width: 860px) {
    .skills__bot2 { display: none; }
  }
  @media (max-width: 560px) {
    .skills__in { margin-inline: 0; padding-inline: 0; }
    .skills__items { columns: 1; }
    .skills__bot1 { display: none; }
    .skills__blk:hover, .skills__blk:focus-visible { translate: 0 0; }
  }
</style>
