---
import { Image } from "astro:assets";
import { profile } from "../data/content";
import Rail from "./Rail.astro";
import cutout from "../assets/richard-cutout.png";
import leaf from "../assets/photos/svc-3.jpg";
import cup from "../assets/photos/work-4.jpg";
import desk from "../assets/photos/work-2.jpg";

/* Composition note (R-31): the sheet is read left to right as a scrapbook
   page. The figure is pasted down the left edge, the title is set across the
   open paper to his right, and the signature sits under its tail. Botanical
   photocopies bleed off two opposite corners so the collage reads as pieces
   laid on a page rather than a layout filling a box. */
---

<section class="slide cover" id="top">
  <Rail no="01" name="Cover" />

  <div class="cover__in rv">
    <Image class="cut cut--bot bleed cover__bot1" src={leaf} alt="" widths={[300, 600]} sizes="24vw" loading="eager" data-drift="5" />
    <Image class="cut cut--bot bleed cover__bot2" src={leaf} alt="" widths={[320, 640]} sizes="26vw" loading="eager" data-drift="6" />

    <figure class="cover__art">
      <Image
        class="cut cut--hard cover__cut"
        src={cutout}
        alt={`${profile.name}, ${profile.role}`}
        widths={[420, 640, 900]}
        sizes="(max-width: 860px) 56vw, 32vw"
        loading="eager"
        fetchpriority="high"
      />
    </figure>

    <h1 class="cover__h">
      <span class="cover__word">Portfolio</span>
      <span class="script cover__sign">{profile.name}</span>
    </h1>

    <p class="cover__lead" data-drift="7">{profile.tagline}</p>

    <figure class="snap cover__snap" data-drift="16">
      <Image src={cup} alt="" class="cut" widths={[260, 520]} sizes="16vw" />
      <figcaption class="script">6am, before the inbox</figcaption>
    </figure>

    <figure class="snap cover__snap2" data-drift="11">
      <Image src={desk} alt="" class="cut" widths={[300, 600]} sizes="18vw" />
      <figcaption class="script">The desk</figcaption>
    </figure>

    <div class="cover__foot">
      <p class="label">{profile.location}</p>
      <p class="label cover__avail"><i aria-hidden="true"></i>{profile.availability}</p>
      <p class="label">{profile.timezone}</p>
    </div>

    <a class="label cover__cue" href="#about">Scroll<i aria-hidden="true"></i></a>
  </div>
</section>

<style>
  .cover__in {
    position: relative;
    z-index: 1;
    flex: 1;
    min-height: clamp(340px, 42vh, 540px);
  }

  /* ── the figure, pasted down the left edge, bleeding off the bottom ── */
  .cover__art {
    position: absolute;
    z-index: 3;
    left: -4%;
    bottom: -5%;
    margin: 0;
    height: 100%;
    rotate: -1.4deg;
  }
  .cover__art :global(.cover__cut) {
    height: 100%;
    width: auto;
    object-fit: contain;
    object-position: bottom center;
  }

  /* ── the title, set in one line across the open paper ── */
  .cover__h {
    position: absolute;
    z-index: 4;
    left: 25%;
    top: 7%;
    right: 0;
    margin: 0;
    display: grid;
    justify-items: end;
  }
  .cover__word {
    display: block;
    font-family: var(--serif);
    font-weight: 900;
    font-size: clamp(2.6rem, 9.9vw, 9.4rem);
    line-height: 0.84;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--pen);
  }
  /* the signature tucks under the tail of the word, the way a hand would
     sign off a printed sheet */
  .cover__sign {
    display: block;
    margin-top: -0.1em;
    margin-right: 0.3em;
    font-size: clamp(1.3rem, 3.3vw, 2.9rem);
    color: var(--pen);
  }
  .cover__lead {
    position: absolute;
    z-index: 4;
    right: 0;
    top: 44%;
    max-width: 22ch;
    text-align: right;
    font-size: clamp(1rem, 1.42vw, 1.42rem);
    line-height: 1.45;
    color: var(--body);
  }
  /* Pasted pieces. The mask is what makes them read as clippings: a hard
     rectangle of photo looks like a placeholder, a faded edge looks torn. */
  .cover__bot1, .cover__bot2 {
    mask-image: radial-gradient(ellipse at 50% 50%, #000 42%, transparent 74%);
  }
  .cover__bot1 {
    top: -44%;
    left: 24%;
    width: clamp(200px, 25%, 330px);
    rotate: 188deg;
    opacity: 1;
  }
  .cover__bot2 {
    right: -7%;
    bottom: -30%;
    width: clamp(210px, 27%, 350px);
    rotate: -8deg;
    opacity: 0.95;
  }
  .cover__snap {
    position: absolute;
    z-index: 5;
    left: 31%;
    bottom: 3%;
    width: clamp(116px, 14.5%, 198px);
    margin: 0;
    rotate: -5deg;
  }
  /* second snapshot: the empty middle of the sheet was the one place the
     collage fell apart, so a piece is pasted across it */
  .cover__snap2 {
    position: absolute;
    z-index: 5;
    left: 54%;
    top: 52%;
    width: clamp(120px, 15%, 206px);
    margin: 0;
    rotate: 4deg;
  }
  .cover__snap2 :global(img) { aspect-ratio: 5 / 4; }
  .cover__snap :global(img) { aspect-ratio: 4 / 5; }
  .cover__snap figcaption,
  .cover__snap2 figcaption {
    padding-top: 0.3rem;
    font-size: 0.9rem;
    text-align: center;
  }

  /* ── foot ── */
  .cover__foot {
    position: absolute;
    z-index: 5;
    left: 46%;
    bottom: -2%;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.4rem;
    color: var(--body);
  }
  .cover__avail { display: inline-flex; align-items: center; gap: 0.45rem; }
  .cover__avail i { width: 7px; height: 7px; border-radius: 50%; background: var(--pen); }

  /* a real control: it scrolls to the next board */
  .cover__cue {
    position: absolute;
    z-index: 5;
    right: 0;
    bottom: -2%;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--pen);
    text-decoration: none;
    cursor: pointer;
  }
  .cover__cue i {
    display: block;
    width: 1px;
    height: 18px;
    background: currentColor;
    transform-origin: 50% 0;
    /* two nudges and it settles: a hint, not a thing that twitches forever */
    animation: cue 2.1s ease-in-out 2;
  }
  .cover__cue:hover, .cover__cue:focus-visible { color: var(--pen-2); }
  .cover__cue:hover i, .cover__cue:focus-visible i { animation-duration: 1.1s; }
  @keyframes cue {
    0%, 100% { transform: scaleY(0.35); opacity: 0.45; }
    45% { transform: scaleY(1); opacity: 1; }
  }

  @media (max-width: 1100px) {
    .cover__h { left: 38%; top: 6%; }
    .cover__lead { max-width: 24ch; top: 58%; }
  }

  /* phones: the collage stacks, the pieces that only work as bleed go away */
  @media (max-width: 860px) {
    .cover__in {
      min-height: 0;
      display: grid;
      gap: 1rem;
      padding-top: 1.6rem;
    }
    .cover__h, .cover__lead, .cover__foot, .cover__art, .cover__snap {
      position: static;
      max-width: none;
      width: auto;
      rotate: none;
    }
    .cover__h { justify-items: start; }
    /* the display word stays one line at every width: broken across two it
       reads as a layout bug, not a cover */
    .cover__word { font-size: min(5.6rem, 12.6vw); }
    .cover__sign { margin-right: 0; }
    .cover__lead { text-align: left; max-width: 44ch; }
    .cover__art { height: auto; justify-self: center; }
    .cover__art :global(.cover__cut) { width: min(230px, 54vw); height: auto; }
    .cover__snap { width: 130px; justify-self: start; rotate: -4deg; }
    .cover__bot1, .cover__bot2 { display: none; }
    .cover__cue { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cover__cue i { animation: none; transform: none; opacity: 1; }
  }
</style>
