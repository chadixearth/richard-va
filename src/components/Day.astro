---
import { Image } from "astro:assets";
import { runlog } from "../data/content";
import Rail from "./Rail.astro";
import Scribble from "./Scribble.astro";
import inbox from "../assets/photos/work-1.jpg";
import desk from "../assets/photos/work-3.jpg";
import grain from "../assets/photos/svc-2.jpg";

const words = runlog.title.split(" ");
const lead = words.slice(0, 2).join(" ");
const tail = words.slice(2).join(" ");

/* the day's busiest block, marked with the highlighter */
const busiest = 2;

/* Composition note (R-31, density pass): the hours own the right 60% of the
   sheet and run its full height, stepped in by hand-written amounts off a pen
   spine that draws downward as the board is read. The heading, its note and
   the two snapshots stack down the left column; a leaf clipping bleeds off the
   bottom-left corner behind them. Pointing at (or tabbing to) an hour brings
   it forward and holds the rest back. */
---

<section class="slide day" id="day">
  <Rail no="04" name="Day" />

  <div class="day__in rv">
    <Image class="cut cut--bot bleed day__bot" data-drift="5" src={grain} alt="" widths={[320, 640]} sizes="28vw" />

    <header class="day__head">
      <h2 class="day__h">
        <span class="d1 day__word">{lead}</span>
        <span class="script day__script">{tail}</span>
      </h2>
      <p class="body-s day__note">{runlog.note}</p>
    </header>

    <div class="day__scrib" data-drift="7"><Scribble lines={4} seed={5} /></div>

    <figure class="snap day__snap day__snap--a" data-drift="14">
      <Image class="cut" src={inbox} alt="" widths={[220, 440]} sizes="18vw" />
      <figcaption class="script" aria-hidden="true">{runlog.rows[0].t}</figcaption>
    </figure>
    <figure class="snap day__snap day__snap--b" data-drift="11">
      <Image class="cut" src={desk} alt="" widths={[220, 440]} sizes="18vw" />
      <figcaption class="script" aria-hidden="true">{runlog.rows[4].t}</figcaption>
    </figure>

    <div class="day__tl">
      <span class="day__spine" data-draw aria-hidden="true"></span>
      <ol class="day__list">
        {
          runlog.rows.map((r, i) => (
            <li class={`day__row day__row--${i}${i === busiest ? " day__row--busy" : ""}`}>
              <span class="day__t">{r.t}</span>
              <p class="body-s day__what">
                <span class="script day__tag">{r.tag.toLowerCase()}</span>
                {r.text}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .day { justify-content: flex-start; }

  .day__in {
    position: relative;
    z-index: 1;
    flex: 1;
    container-type: inline-size;
    display: grid;
    grid-template-columns: 38% minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
    min-height: clamp(400px, 64vh, 600px);
    padding-top: clamp(1.2rem, 2.6vw, 2.2rem);
  }

  /* ── heading and note, top-left ── */
  .day__head {
    position: relative;
    z-index: 3;
    grid-column: 1;
    align-self: start;
    display: grid;
    gap: clamp(0.6rem, 1.4cqi, 1.1rem);
    padding-left: 1.2%;
  }
  .day__h { display: grid; font-size: 0; line-height: 0; }
  .day__word { font-size: clamp(3rem, min(12.2cqi, 17.5vh), 10rem); line-height: 0.84; white-space: nowrap; margin-left: -0.03em; }
  .day__script {
    margin-top: -0.1em;
    margin-left: 0.9em;
    font-size: clamp(1.9rem, 5.2cqi, 4.2rem);
    rotate: -3deg;
    transform-origin: 0 50%;
  }
  .day__note {
    max-width: 28ch;
    margin-left: 0.2rem;
    color: var(--body);
    font-size: clamp(0.9rem, min(1.45cqi, 2.1vh), 1.25rem);
  }

  /* ── the hours: a spine, drawn downward, with six stepped entries ── */
  .day__tl {
    position: relative;
    z-index: 3;
    grid-column: 2;
    display: flex;
    min-width: 0;
    padding-bottom: clamp(0.4rem, 1.2cqi, 1rem);
  }
  .day__spine {
    position: absolute;
    left: 0;
    top: 0.4rem;
    bottom: clamp(0.4rem, 1.2cqi, 1rem);
    width: 2px;
    background: var(--pen);
    transform-origin: 50% 0;
    transform: scaleY(min(1, calc(var(--draw) * 2.2)));
  }
  .day__list {
    list-style: none;
    margin: 0;
    padding: 0 0 0 clamp(1.6rem, 3.2cqi, 2.8rem);
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .day__row {
    --step: 0rem;
    position: relative;
    display: grid;
    grid-template-columns: clamp(4.6rem, 7.6cqi, 6.4rem) minmax(0, 1fr);
    column-gap: clamp(0.7rem, 1.6cqi, 1.4rem);
    align-items: baseline;
    margin-left: var(--step);
    padding-block: clamp(0.35rem, 1.1cqi, 0.9rem);
    outline: none;
    transition: opacity 0.35s ease;
  }
  .day__row--0 { --step: 0rem; }
  .day__row--1 { --step: 1.6rem; }
  .day__row--2 { --step: 0.5rem; }
  .day__row--3 { --step: 2.4rem; }
  .day__row--4 { --step: 0.9rem; }
  .day__row--5 { --step: 2rem; }

  /* the tick that joins each hour back to the spine */
  .day__row::before {
    content: "";
    position: absolute;
    left: calc(-1 * (clamp(1.6rem, 3.2cqi, 2.8rem) + var(--step)));
    width: calc(clamp(1.6rem, 3.2cqi, 2.8rem) + var(--step) - 0.5rem);
    top: 1.35em;
    height: 2px;
    background: var(--pen);
    transform-origin: 0 50%;
    transition: width 0.35s ease, background-color 0.35s ease;
  }

  .day__t {
    position: relative;
    z-index: 0;
    font-family: var(--mono);
    font-size: clamp(0.95rem, 1.5cqi, 1.3rem);
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--ink);
  }
  .day__what {
    color: var(--ink);
    max-width: 60ch;
    font-size: clamp(1rem, 1.5cqi, 1.3rem);
    line-height: 1.5;
  }
  .day__tag {
    display: inline-block;
    font-size: clamp(1.5rem, 2.7cqi, 2.4rem);
    margin-right: 0.4rem;
    vertical-align: -0.08em;
    transform-origin: 0 70%;
    transition: translate 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), scale 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  /* pointing at an hour (or tabbing to it) brings it forward; the others hold back */
  .day__tl:has(.day__row:hover) .day__row:not(:hover) { opacity: 0.38; }
  .day__row:hover .day__tag { translate: 0.5rem 0; scale: 1.12; }
  .day__row:hover::before { width: calc(clamp(1.6rem, 3.2cqi, 2.8rem) + var(--step)); }
  .day__row:focus-visible .day__what { text-decoration: underline; text-decoration-color: var(--pen); text-underline-offset: 0.3em; }

  /* the busiest block: a lime swipe laid behind the hour, fill only */
  .day__row--busy .day__t::before {
    content: "";
    position: absolute;
    z-index: -1;
    left: -0.4rem;
    right: -0.3rem;
    top: 0.2em;
    height: 0.95em;
    background: var(--powder);
    rotate: -2deg;
    border-radius: 2px;
  }

  /* ── pinned snapshots, stacked in the left column ── */
  .day__snap {
    position: absolute;
    z-index: 4;
    width: clamp(100px, min(14.5cqi, 21vh), 190px);
    margin: 0;
  }
  .day__snap :global(img) { aspect-ratio: 4 / 5; }
  .day__snap figcaption { padding-top: 0.25rem; font-size: clamp(0.95rem, 1.5cqi, 1.3rem); text-align: center; }
  .day__snap--a { left: 3%; top: 57%; rotate: -5deg; }
  .day__snap--b { left: 19.5%; top: 61%; rotate: 6deg; }

  .day__scrib {
    position: absolute;
    z-index: 2;
    left: 28%;
    top: 33%;
    width: clamp(84px, 9cqi, 140px);
    rotate: -3deg;
  }
  .day__bot {
    left: -7%;
    bottom: -14%;
    width: clamp(220px, 32cqi, 440px);
    height: auto;
    opacity: 0.75;
    rotate: 18deg;
    mask-image: radial-gradient(ellipse at 50% 50%, #000 42%, transparent 74%);
  }

  @media (max-width: 1100px) {
    .day__scrib { display: none; }
  }

  @media (max-width: 860px) {
    .day__in { min-height: 0; display: block; margin-inline: 0; padding-top: 1.8rem; }
    .day__head { padding-left: 0; }
    .day__tl { margin: 1.4rem 0 0; padding-bottom: 0; }
    .day__list { padding-left: 1.4rem; gap: 0.4rem; }
    .day__row { grid-template-columns: 3.6rem minmax(0, 1fr); --step: 0rem; }
    .day__row--0, .day__row--1, .day__row--2, .day__row--3, .day__row--4, .day__row--5 { --step: 0rem; }
    .day__row::before { left: -1.4rem; width: 0.9rem; }
    .day__snap, .day__scrib, .day__bot { display: none; }
  }
</style>
